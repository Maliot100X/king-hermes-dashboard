{
  "version": 2,
  "name": "king-hermes-dashboard",
  "builds": [
    {
      "src": "dashboard/package.json",
      "use": "@vercel/next"
    }
  ],
  "routes": [
    {
      "src": "/(.*)",
      "dest": "dashboard/$1"
    }
  ],
  "env": {
    "NEXT_PUBLIC_WS_URL": "wss://your-websocket-server.vercel.app",
    "NEXT_PUBLIC_DASHBOARD_URL": "https://king-hermes-dashboard.vercel.app"
  }
}
